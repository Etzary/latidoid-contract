{
  "name": "@geo-intelligence/contract",
  "version": "0.1.0",
  "private": true,
  "description": "Contrato compartido de LatidoID: tipos, esquemas Zod y cliente HTTP tipado para web y mobile.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "msw": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "msw": "^3.0.4",
    "typescript": "^6.0.3"
  }
}
